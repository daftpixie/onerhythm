# OneRhythm — TEST-ONLY environment for the Node/DB tests. Copy to .env.test
# (gitignored) and fill in. These tests talk to the LOCAL Supabase stack only.
#
# SUPABASE_TEST_SERVICE_KEY is the SECRET (service) key from `npx supabase status`
# ("Secret" / sb_secret_…). It is used solely by the admin API in tests to create
# confirmed users deterministically. It is backend/test-only — NEVER put it in
# client code, EXPO_PUBLIC_* vars, or any committed file. The pre-commit guard
# blocks sb_secret_… and any staged .env.

SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=<publishable-key-from-supabase-status>
SUPABASE_TEST_SERVICE_KEY=<secret-key-from-supabase-status>

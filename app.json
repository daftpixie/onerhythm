{
  "expo": {
    "name": "OneRhythm",
    "slug": "onerhythm",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/brand/icons/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/icons/adaptive-icon-foreground-1024.png",
        "monochromeImage": "./assets/brand/icons/adaptive-icon-foreground-1024.png"
      }
    },
    "web": {
      "favicon": "./assets/brand/icons/favicon.png",
      "bundler": "metro"
    },
    "scheme": "onerhythm",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icons/splash-icon-1024.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}

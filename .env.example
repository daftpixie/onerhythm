# OneRhythm — client environment (Expo). Copy to .env.local and fill in.
# Only the PUBLISHABLE (anon) key and project URL ever belong in client env.
# The secret key is backend/test-only and must NEVER appear here. Real .env*
# files are gitignored; this .example template is the only one committed.
#
# Local values come from `npx supabase status` (Project URL + Publishable key).

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
